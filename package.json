{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@switchboard/harness-adapter",
  "version": "0.1.0",
  "description": "Paperclip ServerAdapterModule that runs agents on HarnessRouter over UHP.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "paperclip",
    "harnessrouter",
    "uhp",
    "adapter",
    "agents"
  ],
  "author": "Switchboard (https://switchboard-ai.com)",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@paperclipai/adapter-utils": "^2026.1106.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/node": "^26.6.6",
    "canvas": "^3.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "gsap": "^3.12.7",
    "remotion": "^4.0.0",
    "three": "^0.172.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "harnessrouterjs": "0.1.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "tools",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Switchboard-SI/harness-adapter.git"
  },
  "homepage": "https://github.com/Switchboard-SI/harness-adapter#readme",
  "bugs": {
    "url": "https://github.com/Switchboard-SI/harness-adapter/issues"
  },
  "peerDependencies": {
    "@paperclipai/adapter-utils": "*"
  },
  "peerDependenciesMeta": {
    "@paperclipai/adapter-utils": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}