{
  "name": "harnessrouterjs",
  "version": "0.1.0",
  "description": "JavaScript client and CLI for any server that speaks the Unified Harness Protocol: run agent tasks, stream progress, continue sessions, cancel work, collect artifacts.",
  "keywords": [
    "harnessrouter",
    "uhp",
    "agent",
    "harness",
    "ai-agents",
    "claude-code",
    "codex",
    "client",
    "sdk",
    "cli",
    "streaming"
  ],
  "license": "Apache-2.0",
  "author": "HarnessRouter",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cli.js": "./cli.js"
  },
  "bin": {
    "harnessrouter": "./cli.js",
    "harnessrouterjs": "./cli.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "unifiedharnessprotocol": "^0.1.0",
    "harnessclientprotocol": "^0.1.0"
  },
  "homepage": "https://github.com/HarnessRouter/harnessrouter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarnessRouter/harnessrouter.git"
  },
  "bugs": {
    "url": "https://github.com/HarnessRouter/harnessrouter/issues"
  }
}
